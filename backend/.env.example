# Copy to .env (or export) - every value has a working default for local development.

# --- Django ---
DJANGO_ENV=development                 # production enables HTTPS redirects, HSTS, strict secret
DJANGO_SECRET_KEY=change-me            # required when DJANGO_ENV=production
DJANGO_DEBUG=                          # defaults to true in development, false in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173   # only needed when the SPA is on another origin
NUM_PROXIES=1                          # trusted reverse proxies (for per-client throttling)
LOG_LEVEL=INFO

# --- Caching (optional; in-process memory cache when unset) ---
REDIS_URL=

# --- Third-party services (all free, no key required by default) ---
HTTP_USER_AGENT=weather-aware-truck-routing/1.0
ROUTING_PROVIDERS=valhalla,osrm        # tried in order; next is used only if one is unavailable
VALHALLA_URL=https://valhalla1.openstreetmap.de
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=                        # default public endpoint; or the Worker proxy's
                                       # https://<worker>.workers.dev/v1/forecast
OPEN_METEO_PROXY_KEY=                  # same secret as the Worker's PROXY_KEY (when proxied)
OPEN_METEO_API_KEY=                    # commercial key switches to customer-api.open-meteo.com
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Planner behaviour ---
WIND_BASIS=sustained                   # or "gust" to classify wind risk on gusts
TRUCK_TARE_WEIGHT_LBS=35000            # tractor + empty trailer, added to load for routing
TRUCK_MAX_SPEED_MPH=65                 # only for the car-profile OSRM fallback
MAX_DEPARTURE_DAYS=7
HEATMAP_MAX_CELLS=220                  # forecast locations per corridor heat map
WEATHER_LATTICE_DEG=0.05               # forecast cell size used for de-duplication/caching
WEATHER_CACHE_TTL_S=1800
WEATHER_TIMEOUT_S=15
